{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zob.harness-intake.factory-candidates.v1",
  "type": "object",
  "required": ["schema", "run_id", "candidates"],
  "properties": {
    "schema": { "const": "zob.harness-intake.factory-candidates.v1" },
    "run_id": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factory_name", "purpose", "input_contract", "output_artifacts", "validators", "activation_status", "confidence", "blockers"],
        "properties": {
          "factory_name": { "type": "string" },
          "purpose": { "type": "string" },
          "input_contract": { "type": "string" },
          "output_artifacts": { "type": "array", "items": { "type": "string" } },
          "validators": { "type": "array", "items": { "type": "string" } },
          "activation_status": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "blockers": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
