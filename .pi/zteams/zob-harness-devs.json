  "activeRoom": "harness-control",
  "rooms": [
    { "id": "harness-control", "role": "coordination-owner-facing", "active": true },
    { "id": "harness-architecture", "role": "architecture-and-boundaries", "active": true },
    { "id": "harness-implementation", "role": "bounded-code-and-artifact-changes", "active": true },
    { "id": "harness-coms", "role": "zpeer-goal-room-topology-safety", "active": true },
    { "id": "harness-factory", "role": "repeatable-factory-and-script-workflows", "active": true },
    { "id": "harness-oracle", "role": "validation-no-ship-review", "active": true }
