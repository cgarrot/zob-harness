  "agents": [
    {
      "id": "harness-chief",
      "alias": "harness_chief",
      "rooms": [
        { "id": "harness-control", "alias": "harness_chief", "role": "lead", "active": true }
      ]
    },
    {
      "id": "harness-architect",
      "alias": "harness_architect",
      "rooms": [
        { "id": "harness-control", "alias": "harness_architect", "role": "member", "active": true },
        { "id": "harness-architecture", "alias": "harness_architect", "role": "architect", "active": true },
        { "id": "harness-implementation", "alias": "harness_architect", "role": "structure-reviewer", "active": true }
      ]
    },
    {
      "id": "harness-implementer",
      "alias": "harness_impl",
      "rooms": [
        { "id": "harness-control", "alias": "harness_impl", "role": "member", "active": true },
        { "id": "harness-implementation", "alias": "harness_impl", "role": "implementer", "active": true }
      ]
    },
    {
      "id": "harness-coms-steward",
      "alias": "harness_coms",
      "rooms": [
        { "id": "harness-control", "alias": "harness_coms", "role": "member", "active": true },
        { "id": "harness-coms", "alias": "harness_coms", "role": "coms-steward", "active": true },
        { "id": "harness-oracle", "alias": "harness_coms", "role": "coms-reviewer", "active": true }
      ]
    },
    {
      "id": "harness-factory-engineer",
      "alias": "harness_factory",
      "rooms": [
        { "id": "harness-control", "alias": "harness_factory", "role": "member", "active": true },
        { "id": "harness-factory", "alias": "harness_factory", "role": "factory-engineer", "active": true },
        { "id": "harness-implementation", "alias": "harness_factory", "role": "workflow-builder", "active": true }
      ]
    },
    {
      "id": "harness-oracle",
      "alias": "harness_oracle",
      "rooms": [
        { "id": "harness-control", "alias": "harness_oracle", "role": "oracle", "active": true },
        { "id": "harness-oracle", "alias": "harness_oracle", "role": "oracle", "active": true }
      ]
    }
  ],
  "communicationPolicy": {
    "zpeerContact": true,
    "allowedRooms": ["harness-control", "harness-architecture", "harness-implementation", "harness-coms", "harness-factory", "harness-oracle"],
    "parentVisible": true,
    "hiddenPeerChat": false,
    "workerToWorkerDirect": false,
    "goalRoomCanonical": true,
    "bodyStored": false
  },
  "localOnly": true,
  "networkEnabled": false,
  "bodyStored": false,
  "promptBodiesStored": false,
  "outputBodiesStored": false,
  "metadata": {
    "ownerLaunchRequired": true,
    "entryAgent": "harness-chief",
    "entryRoom": "harness-control",
    "manualReviewCommand": "/zteam launch-plan zob-harness-devs",
    "modePackRef": "zob-harness-devs.modes.json",
    "tmuxLauncher": ".pi/zteams/zob-harness-devs.tmux.sh",
    "tmuxSession": "zob-harness-devs",
    "sourcePatternEvidence": [
      "/Users/cgarrot/zob/project-dna-lab/.pi/zteams/project-dna-builders.json",
      "/Users/cgarrot/zob/project-dna-lab/.pi/zteams/project-dna-builders.tmux.sh",
      "/Users/cgarrot/zob/project-dna-lab/docs/TEAM_COMMUNICATION_PROTOCOL.md"
    ],
    "launchNote": "This manifest is activation-ready but not proof of launch. Review with /zteam launch-plan, then manually run the tmux launcher if desired.",
    "completionGate": "Harness work is complete only after concrete evidence, validation commands, and harness-oracle PASS/no_ship=false."
  }
