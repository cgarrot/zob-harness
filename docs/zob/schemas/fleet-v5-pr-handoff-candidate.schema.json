{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zob.local/schemas/fleet-v5-pr-handoff-candidate.schema.json",
  "title": "Wheel Fleet v5 PR Handoff Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "candidateId",
    "candidateHash",
    "launchId",
    "launchPlanHash",
    "machineId",
    "assignmentHash",
    "workspaceClaimId",
    "machineJournalHeadHash",
    "machineOwnershipEpoch",
    "machineControlWorkspaceRootHash",
    "storyWorkspaceRootHash",
    "bundleId",
    "bundleHash",
    "sourceSha",
    "repositoryId",
    "storyIds",
    "branchName",
    "baseRef",
    "baseSha",
    "headSha",
    "treeHash",
    "contentHash",
    "diffHash",
    "changedPaths",
    "evidenceRefs",
    "evidenceHashes",
    "requestedActions",
    "preparedAt",
    "expiresAt",
    "authorityGranted",
    "commitEnabled",
    "pushEnabled",
    "githubEffectsEnabled",
    "mergeEnabled",
    "promotionEnabled",
    "deploymentEnabled",
    "bodyStored"
  ],
  "properties": {
    "schema": { "const": "wheel.zob.pr-handoff-candidate.v1" },
    "phase": { "enum": ["pre-commit", "post-commit"] },
    "candidateId": { "$ref": "#/$defs/safeId" },
    "candidateHash": { "$ref": "#/$defs/sha256" },
    "launchId": { "$ref": "#/$defs/safeId" },
    "launchPlanHash": { "$ref": "#/$defs/sha256" },
    "machineId": { "$ref": "#/$defs/safeId" },
    "assignmentHash": { "$ref": "#/$defs/sha256" },
    "workspaceClaimId": { "$ref": "#/$defs/safeId" },
    "machineJournalHeadHash": { "$ref": "#/$defs/sha256" },
    "machineOwnershipEpoch": { "type": "integer", "minimum": 1 },
    "machineControlWorkspaceRootHash": { "$ref": "#/$defs/sha256" },
    "storyWorkspaceRootHash": { "$ref": "#/$defs/sha256" },
    "priorPreCommitCandidateId": { "$ref": "#/$defs/safeId" },
    "priorPreCommitCandidateHash": { "$ref": "#/$defs/sha256" },
    "commitAuthorityId": { "$ref": "#/$defs/safeId" },
    "commitAuthorityHash": { "$ref": "#/$defs/sha256" },
    "commitReceiptId": { "$ref": "#/$defs/safeId" },
    "commitReceiptHash": { "$ref": "#/$defs/sha256" },
    "bundleId": { "type": "string", "minLength": 1 },
    "bundleHash": { "$ref": "#/$defs/sha256" },
    "sourceSha": { "$ref": "#/$defs/gitObject" },
    "repositoryId": { "type": "string", "minLength": 1 },
    "storyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "branchName": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "minLength": 1 },
    "baseSha": { "$ref": "#/$defs/gitObject" },
    "headSha": { "$ref": "#/$defs/gitObject" },
    "treeHash": { "$ref": "#/$defs/gitObject" },
    "contentHash": { "$ref": "#/$defs/sha256" },
    "diffHash": { "$ref": "#/$defs/sha256" },
    "changedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } },
    "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repoRef" } },
    "evidenceHashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
    "requestedActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["commit", "push", "create-draft-pr", "observe-ci", "pr-close"] } },
    "preparedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "authorityGranted": { "const": false },
    "commitEnabled": { "const": false },
    "pushEnabled": { "const": false },
    "githubEffectsEnabled": { "const": false },
    "mergeEnabled": { "const": false },
    "promotionEnabled": { "const": false },
    "deploymentEnabled": { "const": false },
    "bodyStored": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "pre-commit" } }, "required": ["phase"] },
      "then": {
        "properties": { "requestedActions": { "const": ["commit"] } },
        "not": {
          "anyOf": [
            { "required": ["priorPreCommitCandidateId"] },
            { "required": ["priorPreCommitCandidateHash"] },
            { "required": ["commitAuthorityId"] },
            { "required": ["commitAuthorityHash"] },
            { "required": ["commitReceiptId"] },
            { "required": ["commitReceiptHash"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "post-commit" } }, "required": ["phase"] },
      "then": {
        "required": ["priorPreCommitCandidateId", "priorPreCommitCandidateHash", "commitAuthorityId", "commitAuthorityHash", "commitReceiptId", "commitReceiptHash"],
        "properties": { "requestedActions": { "not": { "contains": { "const": "commit" } } } }
      }
    }
  ],
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "repoRef": { "type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:\\.env(?:\\.|$)|\\.pi[\\\\/](?:sessions|agent-sessions)(?:[\\\\/]|$)|secrets?(?:[\\\\/]|$)|credentials?(?:[\\\\/]|$))).+$" },
    "sourceRef": { "type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:\\.git|\\.pi)(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])reports[\\\\/]wheel-zob[\\\\/]local-launches(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:\\.env(?:\\.|$)|secrets?(?:[\\\\/]|$)|credentials?(?:[\\\\/]|$))).+$" }
  }
}
