{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wheel:zob:pr-close-evidence:v1",
  "title": "Wheel ZOB PR-Close Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repositoryId", "storyId", "prNumber", "headSha", "baseRef", "manifestHash", "profile", "gates", "draftCi", "audits", "verdict", "issuer", "producedAt", "evidenceHash", "bodyStored"],
  "properties": {
    "schema": {"const": "zob.pr-close-evidence.v1"},
    "repositoryId": {"type": "string"}, "storyId": {"type": "string"}, "prNumber": {"type": "integer", "minimum": 1},
    "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "baseRef": {"type": "string"}, "baseSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "manifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {"type": "object", "additionalProperties": false, "required": ["base", "overlays", "versionRefs"], "properties": {"base": {"type": "string"}, "overlays": {"type": "array", "items": {"type": "string"}}, "versionRefs": {"type": "array", "items": {"type": "string"}}}},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gateId", "status", "evidenceHash"], "properties": {"gateId": {"type": "string"}, "status": {"const": "accepted"}, "evidenceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "draftCi": {"type": "object", "additionalProperties": false, "required": ["expected", "observed", "terminalAcceptable", "deferredReadyOnly", "observedAt"], "properties": {"expected": {"type": "array", "items": {"type": "string"}}, "observed": {"type": "array", "items": {"type": "object", "required": ["name", "conclusion", "runRef"], "properties": {"name": {"type": "string"}, "conclusion": {"type": "string"}, "runRef": {"type": "string"}}, "additionalProperties": false}}, "terminalAcceptable": {"type": "boolean"}, "deferredReadyOnly": {"type": "array", "items": {"type": "string"}}, "observedAt": {"type": "string", "format": "date-time"}}},
    "audits": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["auditType", "attemptId", "assignmentId", "reportHash", "verdict"], "properties": {"auditType": {"enum": ["source-integration", "evidence-qa-ci", "finalizer"]}, "attemptId": {"type": "string"}, "assignmentId": {"type": "string"}, "reportHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "verdict": {"enum": ["pass", "fail", "needs-human"]}}}},
    "humanReceiptHashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "verdict": {"enum": ["pass", "fail", "needs-human", "invalidated"]},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["type", "appId", "checkName", "checkRunId"], "properties": {"type": {"const": "builder-app"}, "appId": {"type": "string"}, "checkName": {"const": "ZOB / PR Close"}, "checkRunId": {"type": "string"}}},
    "producedAt": {"type": "string", "format": "date-time"}, "evidenceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bodyStored": {"const": false}
  }
}