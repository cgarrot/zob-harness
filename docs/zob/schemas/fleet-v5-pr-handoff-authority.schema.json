{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zob.local/schemas/fleet-v5-pr-handoff-authority.schema.json",
  "title": "Wheel Fleet v5 PR Handoff Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "authorityId",
    "candidateId",
    "candidateHash",
    "launchId",
    "launchPlanHash",
    "machineId",
    "assignmentHash",
    "workspaceClaimId",
    "machineJournalHeadHash",
    "machineOwnershipEpoch",
    "machineControlWorkspaceRootHash",
    "storyWorkspaceRootHash",
    "repositoryId",
    "baseRef",
    "baseSha",
    "headSha",
    "contentHash",
    "diffHash",
    "actorIdHash",
    "receiptHash",
    "allowedActions",
    "issuedAt",
    "expiresAt",
    "mergeEnabled",
    "promotionEnabled",
    "deploymentEnabled",
    "bodyStored"
  ],
  "properties": {
    "schema": { "const": "wheel.zob.pr-handoff-authority.v1" },
    "phase": { "enum": ["pre-commit", "post-commit"] },
    "authorityId": { "$ref": "#/$defs/safeId" },
    "candidateId": { "$ref": "#/$defs/safeId" },
    "candidateHash": { "$ref": "#/$defs/sha256" },
    "launchId": { "$ref": "#/$defs/safeId" },
    "launchPlanHash": { "$ref": "#/$defs/sha256" },
    "machineId": { "$ref": "#/$defs/safeId" },
    "assignmentHash": { "$ref": "#/$defs/sha256" },
    "workspaceClaimId": { "$ref": "#/$defs/safeId" },
    "machineJournalHeadHash": { "$ref": "#/$defs/sha256" },
    "machineOwnershipEpoch": { "type": "integer", "minimum": 1 },
    "machineControlWorkspaceRootHash": { "$ref": "#/$defs/sha256" },
    "storyWorkspaceRootHash": { "$ref": "#/$defs/sha256" },
    "repositoryId": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "minLength": 1 },
    "baseSha": { "$ref": "#/$defs/gitObject" },
    "headSha": { "$ref": "#/$defs/gitObject" },
    "contentHash": { "$ref": "#/$defs/sha256" },
    "diffHash": { "$ref": "#/$defs/sha256" },
    "actorIdHash": { "$ref": "#/$defs/sha256" },
    "receiptHash": { "$ref": "#/$defs/sha256" },
    "allowedActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["commit", "push", "create-draft-pr", "observe-ci", "pr-close"] } },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "mergeEnabled": { "const": false },
    "promotionEnabled": { "const": false },
    "deploymentEnabled": { "const": false },
    "bodyStored": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "pre-commit" } }, "required": ["phase"] },
      "then": { "properties": { "allowedActions": { "const": ["commit"] } } }
    },
    {
      "if": { "properties": { "phase": { "const": "post-commit" } }, "required": ["phase"] },
      "then": { "properties": { "allowedActions": { "not": { "contains": { "const": "commit" } } } } }
    }
  ],
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
  }
}
